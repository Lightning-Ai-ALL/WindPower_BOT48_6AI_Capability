# ============================================================
# WindPower_BOT48_6AI_Capability — .gitignore
# 定位：防止「未來」誤提交，非安全邊界
# 安全邊界：公開 Repo 根本不放核心程式
# ============================================================

# ---------- Python (私有核心，絕不上傳) ----------
*.py
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# ---------- Python 虛擬環境 ----------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ---------- 敏感金鑰與憑證 ----------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
credentials.json
secrets.json
*.p12
*.pfx

# ---------- AI 模型檔案 (權重/模型) ----------
*.gguf
*.ggml
*.safetensors
*.bin
*.h5
*.pb
*.onnx
models/
weights/
checkpoints/
*.pt
*.pth

# ---------- 私有開發目錄 ----------
private/
private_core/
internal/
core/
secret/

# ---------- 編譯與建置產物 ----------
build/
dist/
*.so
*.dll
*.dylib
*.a
*.lib
*.exe
*.obj
*.o

# ---------- Node.js (僅忽略依賴目錄，保留 lockfile) ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ⚠️ 注意：不忽略 package-lock.json / yarn.lock / pnpm-lock.yaml
# 理由：公開前端若有建置流程，應鎖定依賴版本以確保 CI 穩定性

# ---------- 作業系統雜項 ----------
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# ---------- 編輯器 / IDE ----------
.vscode/
.idea/
*.iml
.project
.classpath
.settings/

# ---------- 日誌與暫存 ----------
logs/
*.log
tmp/
temp/
*.tmp

# ---------- 測試與覆蓋率 ----------
.coverage
.nyc_output/
coverage/
*.test.js
*.spec.js

# ---------- 你的特定附加規則 ----------
# 請在此列出你想忽略的中文名稱檔案/目錄
# 例如：
# 補充/
# 安裝檔.exe
# *.txt
